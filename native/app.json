{
  "expo": {
    "name": "Household Expense Tracker",
    "slug": "household",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "household",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.example.expensetracker",
      "supportsTablet": false,
      "appleTeamId": "YOUR_TEAM_ID",
      "buildNumber": "13",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C1A24",
        "foregroundImage": "./assets/images/app-icon-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.expensetracker.app",
      "versionCode": 15
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./modules/payment-readers/app.plugin.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1A24",
          "image": "./assets/images/splash-emblem.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.example.expensetracker",
          "widgets": [
            {
              "name": "SpendWidget",
              "displayName": "Spend",
              "description": "Today's and this month's spend, for the household, Sam or Alex",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0B0B0C",
    "runtimeVersion": "native-15",
    "updates": {
      "url": "https://your-app.vercel.app/api/updates",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
